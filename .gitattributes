# Normalize source and documentation while preserving binary fixtures.
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.MF text eol=crlf -whitespace
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.class binary
