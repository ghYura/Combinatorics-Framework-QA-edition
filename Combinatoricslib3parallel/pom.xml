<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.ghYura</groupId>
    <artifactId>combinatoricslib3parallel</artifactId>
    <version>3.4.2-SNAPSHOT</version>
    <name>combinatoricslib3parallel</name>
    <description>Combinatorial objects parallel streams generators for Java.
        A modified derivative of combinatoricslib3 by Dmytro Paukov
        (https://github.com/dpaukov/combinatoricslib3, Apache-2.0), adding
        index-addressable parallel generation, rank-based unranking and fast
        paths, under a renamed package. See NOTICE.md in this directory for
        the attribution and the list of changes.</description>

    <url>https://github.com/ghYura/combinatoricslib3parallel</url>
    <inceptionYear>2026</inceptionYear>

    <!-- Upstream work this library is derived from. Recorded here as well as in
         NOTICE.md so the provenance travels with the built artefact's POM. -->
    <organization>
        <name>Derived from combinatoricslib3 by Dmytro Paukov</name>
        <url>https://github.com/dpaukov/combinatoricslib3</url>
    </organization>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/ghYura/combinatoricslib3parallel.git</connection>
        <developerConnection>scm:git:git://github.com/ghYura/combinatoricslib3parallel.git</developerConnection>
        <url>https://github.com/ghYura/combinatoricslib3parallel</url>
    </scm>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/ghYura/combinatoricslib3parallel/actions</url>
    </ciManagement>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/ghYura/combinatoricslib3parallel</url>
    </issueManagement>

    <developers>
        <!--developer>
            <id>d.paukov</id>
            <name>Dmytro Paukov</name>
            <email>d.paukov@gmail.com</email>
        </developer-->
        <developer>
            <id>y.baranov</id>
            <name>Yurii Baranov</name>
            <email>mail4yur@gmail.com</email>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source><!--maven.compiler.source>1.8</maven.compiler.source-->
        <maven.compiler.target>21</maven.compiler.target><!--maven.compiler.target>1.8</maven.compiler.target-->
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <assertj.version>3.27.7</assertj.version>
        <jacoco.version>0.8.11</jacoco.version>
        <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
        <maven.source.plugin.version>3.3.0</maven.source.plugin.version>
        <maven.surefire.plugin.version>3.1.2</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.1.2</maven.failsafe.plugin.version>
        <maven.javadoc.plugin.version>3.6.0</maven.javadoc.plugin.version>

        <skipTests>true</skipTests>
    </properties>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>

            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.failsafe.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <show>public</show>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
