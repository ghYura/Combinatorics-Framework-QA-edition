# STEP 41 — env template for the local dev DB stack.
# Copy to `.env` (the wrapper does this for you on first `deploy up`) and set a
# LOCAL-ONLY dev password. NEVER commit a real `.env` (it is .gitignore'd).
# This template contains NO real secret — only a placeholder.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_local_dev_only
# The wrapper replaces these legacy-compatible defaults with a shared random
# checkout ID on first use. This prevents a re-downloaded checkout from reusing
# another checkout's PostgreSQL clusters with an unrelated generated password.
BUNDLE_MAIN_DB_VOLUME=fwbundle_main_data
BUNDLE_RESULTS_DB_VOLUME=fwbundle_results_data
# Host ports (bound to 127.0.0.1 only). Defaults avoid clashing with a host
# PostgreSQL on 5433/5432.
BUNDLE_MAIN_DB_HOST_PORT=15433
BUNDLE_RESULTS_DB_HOST_PORT=15432
BUNDLE_MONITORING_HOST_PORT=18080
