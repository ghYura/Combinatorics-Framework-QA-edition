{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundle Iterate Lineage v1",
  "type": "object",
  "required": ["schema", "status", "base_run_id", "iterations"],
  "properties": {
    "schema": { "const": "bundle.iterate/v1" },
    "status": { "type": "string" },
    "base_run_id": { "type": "string" },
    "spec_name": { "type": "string" },
    "db": { "type": "string" },
    "iterations_requested": { "type": "integer", "minimum": 1 },
    "stop_when_stable": { "type": "integer", "minimum": 0 },
    "exploration_floor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "min_winner_support": { "type": "integer", "minimum": 1 },
    "iterations": { "type": "array" },
    "error": { "type": "string" }
  },
  "additionalProperties": true
}
